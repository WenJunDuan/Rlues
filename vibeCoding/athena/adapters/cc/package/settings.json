{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "best",
  "effortLevel": "high",
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "VIBECODING_ATHENA_VERSION": "10.1.0",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "API_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm run test*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run lint*)",
      "Bash(yarn test*)",
      "Bash(bun test*)",
      "Bash(npx playwright)",
      "Bash(npx playwright *)",
      "Bash(npx ecc-agentshield)",
      "Bash(npx ecc-agentshield *)",
      "Bash(node --check*)",
      "Bash(python3 -m pytest*)",
      "Bash(python3 -m unittest*)",
      "Bash(pytest*)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(cmake --build*)",
      "Bash(./gradlew test*)",
      "Bash(./gradlew build*)",
      "Bash(mvn test*)",
      "Bash(mvn compile*)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(go test*)",
      "Bash(go build*)",
      "Bash(eslint *)",
      "Bash(prettier --check*)",
      "Bash(tsc --noEmit*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials.json)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Agent(critic)",
      "Agent(evaluator)",
      "Agent(spec-compliance)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs SessionStart --platform cc",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs UserPromptSubmit --platform cc",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs PreToolUse --platform cc",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs PostToolUse --platform cc",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs PostToolUseFailure --platform cc",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs SubagentStart --platform cc",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs SubagentStop --platform cc",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs ConfigChange --platform cc",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.athena/current/hook.cjs Stop --platform cc",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@anthropic-official": false,
    "code-review@anthropic-official": true,
    "feature-dev@anthropic-official": false,
    "commit@anthropic-official": true,
    "playwright-skill@anthropic-official": true,
    "context7@anthropic-official": true,
    "codex-plugin-cc@third-party-marketplace": false,
    "ECC-AgentShield@third-party-marketplace": true
  }
}
