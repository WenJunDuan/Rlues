{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/vm.schema.json",
  "title": "Athena VM registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "vms"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "vms": {
      "type": "array",
      "items": { "$ref": "#/$defs/vm" }
    }
  },
  "$defs": {
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "user", "auth", "workdir"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22 },
        "user": { "type": "string", "minLength": 1 },
        "os": { "type": "string" },
        "ssh_alias": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "workdir": { "type": "string", "minLength": 1 },
        "purpose": {
          "type": "array",
          "items": { "type": "string", "enum": ["runtime-verify", "e2e", "docker"] }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_session_minutes": { "type": "integer", "minimum": 1, "maximum": 240 }
          }
        },
        "auth": { "$ref": "#/$defs/auth" }
      },
      "not": {
        "anyOf": [
          { "required": ["password"] },
          { "properties": { "auth": { "required": ["password"] } } }
        ]
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "enum": ["key", "password_env"] },
        "key_path": { "type": "string" },
        "password_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "key" } }, "required": ["method"] },
          "then": { "required": ["key_path"] }
        },
        {
          "if": { "properties": { "method": { "const": "password_env" } }, "required": ["method"] },
          "then": { "required": ["password_env"] }
        }
      ]
    }
  }
}
