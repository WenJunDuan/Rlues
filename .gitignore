.DS_Store
__pycache__/
*.py[cod]
*$py.class
.ace-tool/
/.claude/

# Athena 9.9.6 local-only validation/runtime/eval assets (never commit)
vibeCoding/scripts/validate-athena-9.9.6.*
vibeCoding/scripts/test-*-9.9.6-runtime.*
vibeCoding/scripts/evals/athena-9.9.6/

# Athena 9.9.8: canonical validator is committed; local eval leftovers are not
vibeCoding/scripts/test-*-9.9.8-runtime.*
vibeCoding/scripts/evals/athena-9.9.8/

# Athena hook 并发安全 IO 的锁与原子写临时文件 (v9.9.6)
.ai_state/_index.md.lock
.ai_state/_index.md.tmp.*

# hotfix2 (2026-07-29): 遥测退出版本库 (存量文件 git 历史可溯)
