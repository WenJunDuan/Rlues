#!name=🍟 Fries: 🌐 DNS (Mac 定制)
#!desc=基于 GetSomeFries DNS.sgmodule 改写：国内大厂域名交给自家 DNS 解析（CDN 调度更准）；路由器管理域名走系统解析。不改主配置 DNS 四项。
#!author=VirgilClyne (upstream), adapted
#!homepage=https://github.com/VirgilClyne/GetSomeFries/wiki/🌐-DNS
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Server.png
#!category=🍟 Fries

# 与上游差异：
# - 删 [General]：上游 encrypted-dns-follow-outbound-mode = false 会覆盖主配置 true（模块 [General] 优先级高于主配置），
#   导致境外 DoH 不再走代理；use-local-host-item-for-proxy = true 会让代理请求使用下方静态 IP（FCM 静态 IP 已过时）
# - DoH/DoQ 服务器统一写 IP 字面量：免 bootstrap 解析，且命中主配置 [Rule] 第 1 段 DNS IP 直连规则
# - 删：FCM 静态 IP、ip6-* 映射、360（doh.360.cn 静态 IP 不可信）、Apple/TW/HE（这些域名走代理时远端解析，本地指定 DNS 无意义）、
#   *.gifshow.com/*.kspkg.com（快手，上游误归字节）、Google CN 下载域名（与主配置 Google.list → 1.1.1.1 冲突）

[Host]
# > Encrypted DNS 主机名静态映射（供任何以域名形式引用 DoH/DoT 的场景）
dns.google = 8.8.8.8, 8.8.4.4
cloudflare-dns.com = 104.16.249.249, 104.16.248.249
one.one.one.one = 1.1.1.1, 1.0.0.1
1dot1dot1dot1.cloudflare-dns.com = 1.1.1.1, 1.0.0.1
dns.alidns.com = 223.5.5.5, 223.6.6.6
doh.pub = 1.12.12.12, 120.53.53.53
dot.pub = 1.12.12.12, 120.53.53.53

# --- 路由器管理页：系统解析（主配置原 server:system 条目已并入此处）---
*.home.arpa = server:syslib // RFC 8375 家庭网络

# > Router Admin Panel
*.id.ui.direct = server:syslib // Ubiquiti Unifi Network App
unifi.local = server:syslib // Ubiquiti Unifi OS
